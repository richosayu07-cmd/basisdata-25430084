CREATE DATABASE IF NOT EXISTS kopma_25430084;
USE kopma_25430084;

-- 1. Tabel Petugas
CREATE TABLE IF NOT EXISTS petugas (
    id_petugas SMALLINT AUTO_INCREMENT PRIMARY KEY,
    kode_petugas CHAR(3) UNIQUE NOT NULL,
    nama_petugas VARCHAR(100) NOT NULL,
    peran_petugas ENUM('kasir', 'gudang', 'ketua') NOT NULL
);

-- 2. Tabel Anggota Koperasi
CREATE TABLE IF NOT EXISTS anggota (
    id_anggota INT AUTO_INCREMENT PRIMARY KEY,
    no_anggota CHAR(6) UNIQUE NOT NULL,
    nim_anggota CHAR(10) UNIQUE NOT NULL,
    nama_anggota VARCHAR(100) NOT NULL,
    prodi_anggota VARCHAR(60) NOT NULL,
    no_hp_anggota VARCHAR(15),
    status_anggota ENUM('aktif', 'nonaktif') DEFAULT 'aktif',
    tgl_daftar_anggota DATE NOT NULL
);

-- 3. Tabel Pemasok / Rekanan
CREATE TABLE IF NOT EXISTS pemasok (
    id_pemasok INT AUTO_INCREMENT PRIMARY KEY,
    nama_pemasok VARCHAR(100) NOT NULL,
    telepon_pemasok VARCHAR(15),
    alamat_pemasok VARCHAR(200)
);

-- 4. Tabel Katalog Barang
CREATE TABLE IF NOT EXISTS barang (
    id_barang INT AUTO_INCREMENT PRIMARY KEY,
    kode_barang VARCHAR(10) UNIQUE NOT NULL,
    nama_barang VARCHAR(100) NOT NULL,
    kategori_barang ENUM('ATK', 'makanan', 'minuman', 'lainnya') NOT NULL,
    harga_jual_barang DECIMAL(12,2) NOT NULL,
    stok_barang INT DEFAULT 0,
    stok_min_barang INT DEFAULT 5
);

-- 5. Tabel Transaksi Penjualan (Header)
CREATE TABLE IF NOT EXISTS penjualan (
    id_penjualan INT AUTO_INCREMENT PRIMARY KEY,
    no_nota_penjualan CHAR(12) UNIQUE NOT NULL,
    tgl_penjualan DATETIME NOT NULL,
    id_petugas SMALLINT NOT NULL,
    id_anggota INT NOT NULL,
    bayar_penjualan DECIMAL(12,2) NOT NULL,
    CONSTRAINT fk_penjualan_petugas FOREIGN KEY (id_petugas) REFERENCES petugas(id_petugas) ON DELETE RESTRICT ON UPDATE CASCADE,
    CONSTRAINT fk_penjualan_anggota FOREIGN KEY (id_anggota) REFERENCES anggota(id_anggota) ON DELETE RESTRICT ON UPDATE CASCADE
);

-- 6. Tabel Detail Penjualan (Asosiatif M:N Penjualan ke Barang)
CREATE TABLE IF NOT EXISTS detail_penjualan (
    id_penjualan INT,
    id_barang INT,
    qty_detail_penjualan SMALLINT NOT NULL,
    harga_satuan_detail_penjualan DECIMAL(12,2) NOT NULL,
    PRIMARY KEY (id_penjualan, id_barang),
    CONSTRAINT fk_detail_penjualan_penjualan FOREIGN KEY (id_penjualan) REFERENCES penjualan(id_penjualan) ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_detail_penjualan_barang FOREIGN KEY (id_barang) REFERENCES barang(id_barang) ON DELETE RESTRICT ON UPDATE CASCADE
);

-- 7. Tabel Transaksi Pembelian / Pengadaan (Header)
CREATE TABLE IF NOT EXISTS pembelian (
    id_pembelian INT AUTO_INCREMENT PRIMARY KEY,
    no_faktur_pembelian VARCHAR(20) UNIQUE NOT NULL,
    tgl_pembelian DATE NOT NULL,
    id_pemasok INT NOT NULL,
    status_pembelian ENUM('dipesan', 'diterima') DEFAULT 'dipesan',
    CONSTRAINT fk_pembelian_pemasok FOREIGN KEY (id_pemasok) REFERENCES pemasok(id_pemasok) ON DELETE RESTRICT ON UPDATE CASCADE
);

-- 8. Tabel Detail Pembelian (Asosiatif M:N Pembelian ke Barang)
CREATE TABLE IF NOT EXISTS detail_pembelian (
    id_pembelian INT,
    id_barang INT,
    qty_detail_pembelian INT NOT NULL,
    harga_beli_detail_pembelian DECIMAL(12,2) NOT NULL,
    PRIMARY KEY (id_pembelian, id_barang),
    CONSTRAINT fk_detail_pembelian_pembelian FOREIGN KEY (id_pembelian) REFERENCES pembelian(id_pembelian) ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_detail_pembelian_barang FOREIGN KEY (id_barang) REFERENCES barang(id_barang) ON DELETE RESTRICT ON UPDATE CASCADE
);